cff-version: "1.2.0"
message: "Released version 1.1.0. Cite the version actually used, together with the individual PDB entries and their primary papers."
title: "PSI Contact Atlas: heavy-atom contacts around the photosystem I special pair and A1 quinone sites"
type: "dataset"
version: "1.1.0"
authors: [{"family-names": "Nelson", "given-names": "Michael Raymond", "orcid": "https://orcid.org/0009-0004-9809-9842"}]
repository-code: "https://github.com/Fisicas/PSI-contact-atlas"
url: "https://github.com/Fisicas/PSI-contact-atlas/releases/tag/v1.1.0"
license: ["CC-BY-4.0", "MIT"]
abstract: "Heavy-atom separations around the photosystem I special pair, the P_A chlorophyll network and both A1 quinone sites in 22 deposited PDB structures (40 protomers, 160 scenes, 1,107 selected scene rows and 882 unique atom pairs). Includes an offline interactive viewer, homologous comparisons, coordinate crops, CSV tables, PyMOL scripts, archived inputs and reproducible checks. Optional unmasked sections and interactive experimental density cover 39 protomers and 156 scenes, with 208 clickable mesh previews and static image fallbacks. Experimental data for 1JB0 are unavailable. Deposited-model geometry, local-density, preparation and selection-scope qualifications remain explicit. This is a selected PSI contact atlas; the structural census is separate."
keywords: ["photosystem I", "special pair", "P700", "phylloquinone", "A1 quinone", "heavy-atom contacts", "cryo-EM", "X-ray crystallography", "PyMOL"]
date-released: "2026-11-20"
